# Shared
APP_ENV=local
LOG_LEVEL=INFO

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Local dev only — leave false for staging/prod (uvicorn auto-reload).
BACKEND_RELOAD=false
BACKEND_API_PREFIX=/api/v1
# IMPORTANT: replace this default in any shared environment.
# Generate with `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
BACKEND_JWT_SECRET_KEY=change-this-secret-key-at-least-32-bytes
BACKEND_JWT_ALGORITHM=HS256
BACKEND_JWT_ACCESS_TOKEN_MINUTES=15
BACKEND_JWT_REFRESH_TOKEN_DAYS=30
# Optional. Defaults to data/training_clean/drug_database_dav_detailed_10k.json when present.
BACKEND_DRUG_DB_PATH=

# CORS — comma-separated explicit origins (in addition to localhost which is
# always allowed via the regex below). Required for staging/prod web origins.
# Example: BACKEND_CORS_ALLOWED_ORIGINS=https://app.medisign.vn,https://staging.medisign.vn
BACKEND_CORS_ALLOWED_ORIGINS=
BACKEND_CORS_ALLOW_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$

# Rate limiting (slowapi). "<count>/<period>" syntax: 10/minute, 100/hour, etc.
BACKEND_RATE_LIMIT_ENABLED=true
BACKEND_RATE_LIMIT_LOGIN=10/minute
BACKEND_RATE_LIMIT_FORGOT_PASSWORD=5/minute
BACKEND_RATE_LIMIT_REGISTER=5/minute
BACKEND_RATE_LIMIT_AI_CHAT=30/minute

# Database
# Production: use a service account with a strong password — never `postgres/postgres`.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/medisign

# Postgres credentials consumed by docker-compose.yml. Override these in
# staging/prod via the orchestration platform secret store.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=medisign

# Mobile
API_BASE_URL=http://10.0.2.2:8000/api/v1
USE_MOCK_API=true

# AI Configuration
# ============================
# MediSign có 3 deployment modes:
#   - CLOUD: MedGemma 1.5 4B + Medical/Psychology adapter (AI server cloud)
#   - LOCAL: Gemma 2B + 2 Adapters (cần train, on-device)
#   - HYBRID: Kết hợp cả hai
#
# Current MVP: Dùng Rule-based + MedGemma adapter (qua AI server cloud, optional)
#
# Runtime MedGemma integration:
# FastAPI gọi model qua một AI server cloud OpenAI-compatible, không load
# model 4B trực tiếp. Server expose endpoint /v1/chat/completions.
BACKEND_AI_PROVIDER=rule_based
BACKEND_AI_MODEL=google/medgemma-1.5-4b-it
BACKEND_AI_MEDICAL_MODEL=medisign-medgemma-medical
BACKEND_AI_PSYCHOLOGY_MODEL=medisign-medgemma-psychology
BACKEND_AI_BASE_URL=http://localhost:8080/v1
BACKEND_AI_API_KEY=
BACKEND_AI_REQUEST_TIMEOUT_SECONDS=30
BACKEND_RAG_ENABLED=true
BACKEND_RAG_KNOWLEDGE_BASE_PATH=data/knowledge_base/knowledge_base.json
BACKEND_RAG_DEFAULT_TOP_K=5
BACKEND_RAG_MAX_CONTEXT_CHARS=6000
BACKEND_RAG_MIN_SCORE=0.15
BACKEND_MEDGEMMA_BASE_MODEL=google/medgemma-1.5-4b-it
BACKEND_MEDGEMMA_MEDICAL_ADAPTER_PATH=../../output/medisign-medgemma4b-adapter
BACKEND_MEDGEMMA_PSYCHOLOGY_ADAPTER_PATH=../../output/medisign_medgemma4b_psychology/adapter
#
# Xem chi tiết: packages/ai_training/README.md
# - AI Models: MedGemma 1.5 4B + 2 LoRA Adapters (Medical, Psychology)
# - Medicine AI: OCR + Image Classification

# Email (Forgot Password)
# Để trống EMAIL_HOST để dùng chế độ console (in link ra log, không gửi email thật)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM_NAME=MediSign AI
EMAIL_USE_TLS=true
FRONTEND_BASE_URL=http://localhost:3000


# ─────────────────────────────────────────────────────────────────────────
# Sign Mode (VSL) — Gemini Vision recognizer
# ─────────────────────────────────────────────────────────────────────────
# API key cho Google Gemini, dùng ở route handler /api/sign/recognize.
# Lấy free tại https://aistudio.google.com/ → "Get API key" (không cần thẻ).
# Free tier (Dec 2025): 10 RPM / 250 RPD cho Gemini 2.5 Flash, đủ demo+dev.
#
# An toàn: KEY chỉ đọc ở server (Next.js Route Handler), không expose client.
# KHÔNG đặt prefix NEXT_PUBLIC_ nếu không sẽ bị bundle vào browser.
GOOGLE_GEMINI_API_KEY=
