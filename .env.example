# Shared
APP_ENV=local
LOG_LEVEL=INFO

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=true
BACKEND_API_PREFIX=/api/v1
BACKEND_JWT_SECRET_KEY=change-this-secret-key-at-least-32-bytes
BACKEND_JWT_ALGORITHM=HS256
BACKEND_JWT_ACCESS_TOKEN_MINUTES=15
BACKEND_JWT_REFRESH_TOKEN_DAYS=30

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/medisign

# Mobile
API_BASE_URL=http://10.0.2.2:8000/api/v1
USE_MOCK_API=true

# AI Configuration
# ============================
# MediSign có 3 deployment modes:
#   - CLOUD: Qwen 72B + Medical Adapter (cần train)
#   - LOCAL: Gemma 2B + 2 Adapters (cần train)
#   - HYBRID: Kết hợp cả hai
#
# Current MVP: Dùng Rule-based + Qwen (enhancement only)
# Qwen/Gemini chỉ là FALLBACK khi server quá tải, không phải primary!
#
# AI_PROVIDER=qwen     # "qwen", "gemini", hoặc "local"
# DASHSCOPE_API_KEY=   # API key cho Qwen (Alibaba DashScope)
# AI_MODEL=qwen-turbo
#
# Xem chi tiết: packages/ai_training/README.md
# - AI Models: Qwen 72B, Gemma 2B, 2 LoRA Adapters
# - Medicine AI: OCR + Image Classification
