{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TriageRequest",
  "type": "object",
  "required": ["symptom_text"],
  "properties": {
    "symptom_text": {
      "type": "string",
      "minLength": 3,
      "maxLength": 1000
    },
    "locale": {
      "type": "string",
      "minLength": 2,
      "maxLength": 10,
      "default": "vi-VN"
    }
  },
  "additionalProperties": false
}
