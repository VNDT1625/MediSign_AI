  "required": ["extracted_text"],
  "properties": {
    "extracted_text": {
      "type": "string",
      "minLength": 2,
      "maxLength": 500
    },
    "current_medications": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": false
}
